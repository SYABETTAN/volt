---
import Base from "../components/Base.astro";
---

<Base
  title="Page introuvable"
  description="Cette page n’existe pas sur le site de démonstration VOLT."
>
  <article class="legal wrap">
    <p class="kicker">404</p>
    <h1>Cette page n’existe pas.</h1>
    <p class="lede stack">
      Le lien est peut-être incomplet. Le site de démonstration commence à
      l’accueil.
    </p>
    <p class="stack">
      <a class="btn btn-primary" href="/">
        Retour à l’accueil
      </a>
    </p>
  </article>
</Base>
