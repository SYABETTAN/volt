---
import { site, CERTIFICATION_LABEL } from "../config/site";

const visible =
  site.mode === "demo"
    ? site.certifications
    : site.certifications.filter((item) => item.documented);
---

<section class="section wrap" aria-labelledby="certs-title">
  <div class="section-head">
    <div>
      <p class="kicker">
        {site.showFictionLabels ? CERTIFICATION_LABEL : "Agréments"}
      </p>
      <h2 id="certs-title">L’emplacement des preuves.</h2>
    </div>
    <p>
      Aucun logo d’organisme et aucune qualification ne sont affichés. Un client
      réel n’activera ces cases qu’avec des documents à jour.
    </p>
  </div>
  <div class="cert-grid">
    {visible.map((item) => (
      <article class="cert">
        <p class="kicker">
          {site.showFictionLabels ? CERTIFICATION_LABEL : "Documenté"}
        </p>
        <h3>{item.title}</h3>
        <p>{item.summary}</p>
      </article>
    ))}
  </div>
</section>
