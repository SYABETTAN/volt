---
import { site } from "../config/site";
---

{site.showAgencyCta && (
  <section class="agency band" aria-labelledby="agency-band-title">
    <div class="wrap">
      <p class="kicker">Création de sites — hors entreprise VOLT</p>
      <h2 id="agency-band-title">
        Un site professionnel, sans gérer la technique.
      </h2>
      <p class="lede">
        Votre nom, vos chantiers réels et vos informations vérifiées, dans un
        cadre de cette tenue. VOLT reste une démonstration.
      </p>
      <div class="cluster stack">
        <button class="btn btn-primary" type="button" data-open="agency-dialog">
          Je veux mon site
        </button>
        <button
          class="btn btn-ghost"
          type="button"
          data-open="diagnostic-dialog"
        >
          Diagnostic gratuit
        </button>
      </div>
      <p class="note">
        La demande ouvre votre messagerie vers {site.inquiry.recipient}. Ce site
        n’envoie rien lui-même.
      </p>
    </div>
  </section>
)}
