---
import { Image } from "astro:assets";
import { site } from "../config/site";
import type { ProjectImage } from "../types/content";
import type { ImageMetadata } from "astro";
import ouvert from "../assets/photos/stair-light.jpg";
import escalier from "../assets/photos/kitchen.jpg";
import facade from "../assets/photos/house.jpg";
import suspension from "../assets/photos/bulb.jpg";
import borne from "../assets/photos/charger.jpg";
import detail from "../assets/photos/lamp.jpg";

const images: Record<ProjectImage, ImageMetadata> = {
  ouvert,
  escalier,
  facade,
  suspension,
  borne,
  detail,
};
---

<section
  class="section wrap"
  id="realisations"
  aria-labelledby="projects-title"
>
  <div class="section-head">
    <div>
      <p class="kicker">Réalisations</p>
      <h2 id="projects-title">Projets illustratifs.</h2>
    </div>
    <p>
      Ces images montrent une manière de présenter des chantiers. Elles ne
      documentent aucun travail réalisé par VOLT. Ouvrez une fiche pour la lire
      plus confortablement.
    </p>
  </div>
  <div class="projects">
    {site.projects.map((project) => (
      <button
        class="project-card"
        type="button"
        data-lightbox
        data-title={project.title}
        data-category={project.category}
        data-summary={project.summary}
      >
        <Image
          src={images[project.image]}
          alt={project.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 52rem) 34vw, 100vw"
          quality={66}
          class="media"
        />
        <span class="project-meta">
          <span>{project.category}</span>
          <span>Projet illustratif</span>
        </span>
        <h3>{project.title}</h3>
      </button>
    ))}
  </div>
</section>

<dialog id="project-dialog" aria-labelledby="project-dialog-title">
  <div class="dialog-panel">
    <div class="dialog-head">
      <p class="kicker" id="project-dialog-category"></p>
      <button class="btn btn-ghost" type="button" data-close>
        Fermer
      </button>
    </div>
    <img id="project-dialog-image" class="media stack" alt="" />
    <h2 id="project-dialog-title" class="stack"></h2>
    <p id="project-dialog-summary" class="stack"></p>
    <p class="note">
      Projet illustratif. Photographie d’ambiance, non attribuée à VOLT.
    </p>
    <div class="actions">
      <button class="btn btn-ghost" type="button" id="project-prev">
        Précédent
      </button>
      <button class="btn btn-ghost" type="button" id="project-next">
        Suivant
      </button>
    </div>
  </div>
</dialog>
