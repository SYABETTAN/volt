---
import { site, DISCLAIMER } from "../config/site";

const brand = site.business.brand;
---

<header class="topbar">
  <div class="demo-bar">
    <div class="demo-bar-inner wrap">
      <a class="skip" href="#contenu">
        Aller au contenu
      </a>
      {site.showFictionLabels && <p>{DISCLAIMER}</p>}
      {site.showAgencyCta && (
        <p class="bar-offer">
          <span>Vous êtes électricien ?</span>
          <button type="button" data-open="personalize-dialog">
            Visualiser mon futur site
          </button>
        </p>
      )}
    </div>
  </div>
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-name" data-brand>
        {brand}
      </span>
      <span class="brand-meta">{site.business.descriptor}</span>
    </a>
    <nav class="nav-desktop" aria-label="Sections">
      {site.navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="btn btn-primary" href="/#devis">
        Devis
      </a>
      <button
        class="btn btn-ghost menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu-dialog"
        data-open="menu-dialog"
      >
        Menu
      </button>
    </div>
  </div>
</header>

<dialog id="menu-dialog" class="menu-dialog" aria-labelledby="menu-title">
  <div class="dialog-panel">
    <div class="dialog-head">
      <h2 id="menu-title">Menu</h2>
      <button class="btn btn-ghost" type="button" data-close>
        Fermer
      </button>
    </div>
    <nav class="menu-list" aria-label="Navigation mobile">
      {site.navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      {site.mode === "demo" && (
        <button type="button" data-open="personalize-dialog">
          Visualiser mon futur site
        </button>
      )}
      {site.showAgencyCta && (
        <button type="button" data-open="agency-dialog">
          Je veux mon site
        </button>
      )}
      {site.showAgencyCta && (
        <button type="button" data-open="diagnostic-dialog">
          Diagnostic gratuit
        </button>
      )}
    </nav>
  </div>
</dialog>
