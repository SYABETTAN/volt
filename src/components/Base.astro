---
import "../styles/global.css";
import { site } from "../config/site";
import { serializeJsonLd, structuredData } from "../lib/schema";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle =
  site.mode === "demo" ? `${title} | Site de démonstration` : title;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const robots =
  site.indexing === "noindex"
    ? "noindex, nofollow, noarchive"
    : "index, follow";
const schema = structuredData(site);
const ogImage = Astro.site ? new URL("/og.jpg", Astro.site).href : undefined;
---

<!doctype html>
<html
  lang="fr"
  data-accent="volt"
  data-default-brand={site.business.brand}
  data-inquiry-to={site.inquiry.recipient}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#171614" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {schema && (
      <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
    )}
  </head>
  <body>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script>
      import { initInterface } from "../scripts/ui";
      initInterface();
    </script>
  </body>
</html>
